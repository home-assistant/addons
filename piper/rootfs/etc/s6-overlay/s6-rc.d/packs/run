#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Install the optional feature packs selected in the app configuration.
#
# Japanese, Thai and OmniVoice are not part of the image: together they are
# ~1.5 GB, for options most installs never turn on. They are installed here
# instead, into the container's own site-packages -- which is thrown away with
# the container -- from a uv cache kept in /data.
#
# uv symlinks the files out of that cache rather than copying them, so the
# installed tree is a few MB of links and only the cache takes real space. And
# because the tree is rebuilt on every start against the interpreter that is
# actually running, there is nothing to keep in sync: a base image with a new
# Python simply misses in the cache and downloads again.
#
# A pack that fails to install is not fatal here. Whether it was actually
# needed depends on the backend and voice, so the Piper service decides that
# and fails with a message naming the option to turn on.
# ==============================================================================

export UV_CACHE_DIR='/data/uv-cache'
export UV_SYSTEM_PYTHON=true

# /data and the container filesystem are different mounts, so uv's default
# hardlink mode silently degrades to full copies and every pack would cost its
# size twice -- once in the cache, once installed. Symlinks span mounts.
export UV_LINK_MODE=symlink

# Discard the cache when either the interpreter or wyoming-piper moves to a new
# series, so it cannot grow without bound across app updates. A new Python minor
# changes the ABI tag and strands every cached wheel; a new wyoming-piper minor
# can move dependency floors far enough that the cached resolution is dead
# weight. Patch releases change neither, so 2.5.1 -> 2.5.2 keeps the cache and
# 2.5.x -> 2.6.x does not.
readonly cache_series_file="${UV_CACHE_DIR}/.series"
# Defaulted because bashio runs with "set -o nounset": the version comes from
# the image environment and is always set in practice, but an unset one must
# not abort the service before a single pack is installed.
piper_version="${WYOMING_PIPER_VERSION:-}"
cache_series="python=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
cache_series+=" wyoming-piper=${piper_version%.*}"

if [[ -f "${cache_series_file}" ]] \
    && [[ "$(< "${cache_series_file}")" != "${cache_series}" ]]; then
    bashio::log.info \
        "Discarding pack cache: $(< "${cache_series_file}") -> ${cache_series}"
    rm -rf "${UV_CACHE_DIR}"
fi

mkdir -p "${UV_CACHE_DIR}"
printf '%s\n' "${cache_series}" > "${cache_series_file}"

# Try the cache before the network, so a restart costs no index round trip and
# an installation without internet access still comes back up. Falls back to a
# normal online install whenever anything is missing from the cache.
install_pack() {
    local name="${1}"
    shift

    if uv pip install --quiet --offline "$@" > /dev/null 2>&1; then
        bashio::log.info "${name}: restored from cache"
        return 0
    fi

    bashio::log.info "${name}: downloading, this can take several minutes..."
    if uv pip install --quiet "$@"; then
        bashio::log.info "${name}: installed"
        return 0
    fi

    bashio::log.warning "${name}: install failed"
    return 1
}

# The three OmniVoice steps cannot be one requirement: torch has to come from
# the CPU index (PyPI's default wheels carry ~2.7 GB of CUDA libraries that are
# never loaded), and the omnivoice package has to be installed without its
# dependencies -- gradio, librosa, webdataset and tensorboardx are only used by
# its demo and training paths, which this backend never imports. The
# omnivoice-deps extra pins what it does import.
install_omnivoice() {
    install_pack 'OmniVoice (PyTorch, CPU)' \
        --index-url https://download.pytorch.org/whl/cpu \
        torch \
        torchaudio || return 1

    install_pack 'OmniVoice (dependencies)' \
        "wyoming-piper[omnivoice-deps] @ https://github.com/rhasspy/wyoming-piper/archive/refs/tags/v${piper_version}.tar.gz" \
        || return 1

    install_pack 'OmniVoice' --no-deps omnivoice || return 1
}

packs_selected='false'

# "|| true" throughout: bashio runs with "set -o errexit", so without it a
# single failed download would abort this service, skip every remaining pack,
# and -- because the Piper service depends on this one -- could stop the app
# from starting at all. Whether a missing pack actually matters depends on the
# backend and voice, which the Piper service decides.
if bashio::config.true 'enable_japanese'; then
    packs_selected='true'
    install_pack 'Japanese (OpenJTalk)' 'piper-tts[ja]' || true
fi

if bashio::config.true 'enable_thai'; then
    packs_selected='true'
    # tltk imports requests without declaring it. wyoming-piper's own "th"
    # extra works around that, but this installs piper-tts[th] directly to
    # avoid re-fetching wyoming-piper, so the workaround is repeated here.
    install_pack 'Thai (TLTK)' 'piper-tts[th]' requests || true
fi

if [[ "$(bashio::config 'backend')" == 'omnivoice' ]]; then
    packs_selected='true'

    if [[ "$(uname -m)" != 'x86_64' ]]; then
        bashio::log.warning \
            "OmniVoice is being installed on $(uname -m). It is designed for a" \
            "desktop or server CPU and will be very slow on this hardware."
    fi

    install_omnivoice || true
fi

# Report what /data holds. On Home Assistant OS it cannot be browsed without a
# host shell, so the log is the only place this is visible.
if bashio::var.true "${packs_selected}"; then
    bashio::log.info "Pack cache: $(du -sh "${UV_CACHE_DIR}" | cut -f1) in ${UV_CACHE_DIR}"
fi

if bashio::config.true 'debug_logging'; then
    while read -r entry; do
        bashio::log.info "/data: ${entry}"
    done < <(du -sh /data/* 2>/dev/null)
fi

# Never block Piper from starting: the service checks for what it actually
# needs and reports a usable error itself.
exit 0
