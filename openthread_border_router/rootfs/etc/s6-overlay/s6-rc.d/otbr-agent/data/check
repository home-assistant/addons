#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -e

# Check if openthread socket exists
test -S /run/openthread-wpan0.sock

# Check REST API port is open
mapfile -t < /tmp/otbr-agent-rest-api
nc -z "${MAPFILE[@]}"

# s6-rc oneshots do not run again when s6-supervise restarts a process.
# Configure every new agent before notifying dependent services of readiness.
/etc/s6-overlay/scripts/otbr-agent-configure.sh

# shellcheck source=./openthread_border_router/rootfs/etc/s6-overlay/scripts/otbr-agent-common
. /etc/s6-overlay/scripts/otbr-agent-common
date +%s > "${otbr_started_file}"
