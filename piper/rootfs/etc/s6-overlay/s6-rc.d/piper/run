#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Start Piper service
# ==============================================================================

# Reference recordings for OmniVoice cloning voices, uploaded through the web
# UI. Kept separate from the Piper voice models, which are <voice>.onnx pairs
# sitting directly in /data (and /share/piper); an OmniVoice voice is a
# <language>/<name>/ directory instead.
readonly omnivoice_voices_dir='/data/omnivoice_voices'

# Ingress proxies to the container's address rather than to loopback, so the web
# UI has to bind every interface -- which also puts it in reach of every other
# app on the same Docker network. It has no authentication of its own, so the
# peer address is restricted to the ingress proxy, whose address is fixed. The
# port is deliberately not published in config.yaml either.
readonly web_server_port=8099
readonly ingress_proxy='172.30.32.2'

# True if a module the "packs" service installs is importable.
have_module() {
    python3 -c \
        "import importlib.util, sys; sys.exit(importlib.util.find_spec('${1}') is None)"
}

flags=()

if bashio::config.true 'debug_logging'; then
    flags+=('--debug')
fi

mkdir -p "${omnivoice_voices_dir}"

backend="$(bashio::config 'backend')"
if [[ "${backend}" == 'omnivoice' ]]; then
    if ! have_module 'omnivoice'; then
        # One argument: bashio::exit.nok only logs its first.
        bashio::exit.nok \
            "The OmniVoice backend is not installed. Check the log above for a failed download, or set 'backend' back to 'piper'."
    fi

    flags+=(
        '--backend' 'omnivoice'
        '--omnivoice-steps' "$(bashio::config 'omnivoice_steps')"
    )
else
    # Japanese and Thai need a phonemizer that is only installed when its
    # option is on. Checked here so the failure names the option, instead of
    # surfacing as silence the first time something is spoken. Only the default
    # voice can be checked -- Home Assistant may request any voice at runtime.
    voice="$(bashio::config 'voice')"
    case "${voice}" in
        ja_*|ja-*)
            have_module 'pyopenjtalk' || bashio::exit.nok \
                "The Japanese voice '${voice}' needs the 'enable_japanese' option to be turned on."
            ;;
        th_*|th-*)
            have_module 'tltk' || bashio::exit.nok \
                "The Thai voice '${voice}' needs the 'enable_thai' option to be turned on."
            ;;
    esac

    # Piper-only synthesis settings; the omnivoice backend ignores them.
    flags+=(
        '--voice' "${voice}"
        '--speaker' "$(bashio::config 'speaker')"
        '--length-scale' "$(bashio::config 'length_scale')"
        '--noise-scale' "$(bashio::config 'noise_scale')"
        '--noise-w' "$(bashio::config 'noise_w')"
    )

    if bashio::config.true 'update_voices'; then
        flags+=('--update-voices')
    fi
fi

# Delete old options
options=$(bashio::addon.options)
for old_key in 'max_piper_procs' 'streaming'; do
    if bashio::jq.exists "${options}" ".${old_key}"; then
        bashio::log.info "Removing ${old_key}"
        bashio::addon.option "${old_key}"
    fi
done

# --omnivoice-ref-dir is passed for both backends so the web UI can manage
# cloning voices even while Piper is the active backend.
#
# shellcheck disable=SC2068
exec python3 -m wyoming_piper \
    --uri 'tcp://0.0.0.0:10200' \
    --zeroconf \
    --sentence-silence "$(bashio::config 'sentence_silence')" \
    --data-dir /data \
    --data-dir /share/piper \
    --download-dir /data \
    --omnivoice-ref-dir "${omnivoice_voices_dir}" \
    --web-server \
    --web-server-host '0.0.0.0' \
    --web-server-port "${web_server_port}" \
    --web-server-allow "${ingress_proxy}" ${flags[@]}
